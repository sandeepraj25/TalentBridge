# ---- Server ----
PORT=4000
# Comma-separated list of allowed frontend origins (the deployed SPA URL + localhost for dev)
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth ----
# Use a long random string in production, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- MySQL (Hostinger: hPanel -> Databases -> MySQL) ----
# On Hostinger, enable "Remote MySQL" and whitelist your API server's IP.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rojgaar

# ---- Payment gateways (optional env fallback; admin settings in the portal take precedence) ----
# Used to encrypt gateway secrets stored in the database. Use a long random string in production.
PAYMENT_ENCRYPTION_KEY=
# Active gateway if none is saved in admin settings: razorpay | cashfree
PAYMENT_ACTIVE_GATEWAY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# sandbox | production
CASHFREE_ENV=sandbox
